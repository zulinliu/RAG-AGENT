# ─────────────────────────────────────────────────────────────────────
# RAG-AGENT Environment Variables
# Copy this file to .env and adjust values for your environment
# ─────────────────────────────────────────────────────────────────────

# ─── General ────────────────────────────────────────────────────────
# Environment: dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ─── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ragagent123
REDIS_DB=0

# ─── Milvus ─────────────────────────────────────────────────────────
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ─── Elasticsearch ──────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=rag_chunks

# ─── MinIO ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs
MINIO_USE_SSL=false

# ==================== LLM ====================
# Local vLLM deployment
LLM_PROVIDER=local
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL_NAME=Qwen2.5-72B-Instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ZhiPu GLM (uncomment to use)
# LLM_PROVIDER=zhipu
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=your-zhipu-api-key
# LLM_MODEL_NAME=glm-4-plus

# DeepSeek (uncomment to use)
# LLM_PROVIDER=deepseek
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL_NAME=deepseek-chat

# MiniMax (uncomment to use)
# LLM_PROVIDER=minimax
# LLM_API_BASE=https://api.minimax.chat/v1
# LLM_API_KEY=your-minimax-api-key
# LLM_MODEL_NAME=abab6.5s-chat

# SiliconFlow (uncomment to use)
# LLM_PROVIDER=siliconflow
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_API_KEY=your-siliconflow-api-key
# LLM_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Ollama (uncomment to use)
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL_NAME=qwen2.5:32b

# ==================== Embedding ====================
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=http://embedding-worker:8100
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# SiliconFlow Embedding (uncomment to use)
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# EMBEDDING_API_KEY=your-siliconflow-api-key
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# ==================== Reranker ====================
RERANKER_PROVIDER=local
RERANKER_API_URL=http://embedding-worker:8100/rerank
RERANKER_API_KEY=
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_THRESHOLD=0.3

# ─── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=changeme-use-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Application ───────────────────────────────────────────────────
BACKEND_PORT=8000
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
