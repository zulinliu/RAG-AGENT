# ─────────────────────────────────────────────────────────────────────
# RAG-AGENT 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# 所有 *_PROVIDER 参数控制本地部署 / 云端 API 的切换
# ─────────────────────────────────────────────────────────────────────

# ─── General ────────────────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ─── PostgreSQL ─────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=rag_agent

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ragagent123
REDIS_DB=0

# ─── Milvus ─────────────────────────────────────────────────────────
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_chunks
MILVUS_COLLECTION_PREFIX=rag

# ─── Elasticsearch ──────────────────────────────────────────────────
ES_HOSTS=http://elasticsearch:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_INDEX_NAME=rag_chunks
ES_INDEX_PREFIX=rag

# ─── MinIO ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs

# =====================================================================
# LLM 大语言模型配置
# =====================================================================
# provider 选项:
#   local        - 本地 vLLM / Ollama 部署（默认，需 GPU）
#   zhipu        - 智谱AI (GLM 系列)
#   minimax      - MiniMax
#   deepseek     - DeepSeek
#   siliconflow  - 硅基流动
#   ollama       - Ollama 本地
#   openai       - OpenAI 或兼容中转（如 NewAPI）
#   custom       - 自定义 OpenAI 兼容端点（需手动设置 API_BASE）
# =====================================================================

# ── 方式 1: 本地 vLLM 部署（默认） ──────────────────────────────────
LLM_PROVIDER=local
LLM_API_KEY=
# Docker Compose 默认使用 http://host.docker.internal:8001/v1；
# 后端直接在宿主机运行且该值留空时，代码默认使用 http://localhost:8001/v1。
LLM_API_BASE=
LLM_MODEL_NAME=Qwen2.5-72B-Instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── 方式 2: 智谱AI ──────────────────────────────────────────────────
# LLM_PROVIDER=zhipu
# LLM_API_KEY=your-zhipu-api-key
# LLM_MODEL_NAME=glm-4-plus

# ── 方式 3: DeepSeek ────────────────────────────────────────────────
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL_NAME=deepseek-chat

# ── 方式 4: MiniMax ─────────────────────────────────────────────────
# LLM_PROVIDER=minimax
# LLM_API_KEY=your-minimax-api-key
# LLM_MODEL_NAME=MiniMax-Text-01

# ── 方式 5: 硅基流动 ────────────────────────────────────────────────
# LLM_PROVIDER=siliconflow
# LLM_API_KEY=your-siliconflow-api-key
# LLM_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# ── 方式 6: Ollama 本地 ─────────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=qwen2.5:32b

# ── 方式 7: OpenAI 兼容中转（NewAPI / OneAPI 等） ──────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=your-relay-api-key
# LLM_API_BASE=https://your-newapi-domain.com/v1
# LLM_MODEL_NAME=gpt-4o

# ── 方式 8: 自定义端点 ──────────────────────────────────────────────
# LLM_PROVIDER=custom
# LLM_API_KEY=your-api-key
# LLM_API_BASE=https://your-custom-endpoint.com/v1
# LLM_MODEL_NAME=your-model-name

# =====================================================================
# Embedding 向量模型配置
# =====================================================================
# provider 选项:
#   tei          - HuggingFace TEI Docker 本地部署（默认，推荐，CPU 即可）
#   siliconflow  - 硅基流动 API（云端，同款 bge 模型，零部署）
#   zhipu        - 智谱AI Embedding-3（云端，自有模型）
#   openai       - OpenAI 兼容端点（中转 / relay）
#   custom       - 自定义 OpenAI 兼容端点
#   local-py     - 进程内 transformers 加载（仅开发用）
# =====================================================================

# ── 方式 1: 本地 TEI Docker 部署（默认，推荐） ──────────────────────
# 无需 API Key，CPU 即可运行，性能足够 50-200 人使用
# docker-compose 中已包含 embedding-worker 服务
EMBEDDING_PROVIDER=tei
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ── 方式 2: 硅基流动 API（云端，同款 bge 模型） ────────────────────
# 无需本地部署，API 直接调用
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_API_KEY=your-siliconflow-api-key
# EMBEDDING_API_BASE=
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIMENSION=1024

# ── 方式 3: 智谱AI Embedding-3（云端，自有模型） ────────────────────
# 注意：维度与 bge 不同，需同步修改 EMBEDDING_DIMENSION
# EMBEDDING_PROVIDER=zhipu
# EMBEDDING_API_KEY=your-zhipu-api-key
# EMBEDDING_API_BASE=
# EMBEDDING_MODEL_NAME=embedding-3
# EMBEDDING_DIMENSION=2048

# ── 方式 4: OpenAI 兼容中转 ────────────────────────────────────────
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your-relay-api-key
# EMBEDDING_API_BASE=https://your-relay.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# ── 方式 5: 进程内加载（仅开发测试） ──────────────────────────────
# EMBEDDING_PROVIDER=local-py
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# =====================================================================
# Reranker 重排序模型配置
# =====================================================================
# provider 选项:
#   tei          - HuggingFace TEI Docker 本地部署（默认，推荐）
#   siliconflow  - 硅基流动 API（云端）
#   cohere       - Cohere rerank API
#   jina         - Jina rerank API
#   custom       - 自定义端点
#   local-py     - 进程内 sentence-transformers（仅开发用）
# =====================================================================

# ── 方式 1: 本地 TEI Docker 部署（默认，推荐） ──────────────────────
# 无需 API Key，CPU 即可运行
# docker-compose 中已包含 reranker-worker 服务
RERANKER_PROVIDER=tei
RERANKER_API_KEY=
RERANKER_API_BASE=
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_THRESHOLD=0.3

# ── 方式 2: 硅基流动 API ────────────────────────────────────────────
# RERANKER_PROVIDER=siliconflow
# RERANKER_API_KEY=your-siliconflow-api-key
# RERANKER_API_BASE=
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ── 方式 3: 自定义端点 ──────────────────────────────────────────────
# RERANKER_PROVIDER=custom
# RERANKER_API_KEY=your-api-key
# RERANKER_API_BASE=https://your-reranker-endpoint.com
# RERANKER_MODEL_NAME=your-reranker-model

# ── 方式 4: 进程内加载（仅开发测试） ──────────────────────────────
# RERANKER_PROVIDER=local-py
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ─── JWT Authentication ────────────────────────────────────────────
AUTH_SECRET_KEY=changeme-use-strong-secret-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
