# ─────────────────────────────────────────────────────────────────────
# RAG-AGENT Environment Variables
# Copy this file to .env and adjust values for your environment
# ─────────────────────────────────────────────────────────────────────

# ─── General ────────────────────────────────────────────────────────
# Environment: dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ─── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ragagent123
REDIS_DB=0

# ─── Milvus ─────────────────────────────────────────────────────────
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ─── Elasticsearch ──────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=rag_chunks

# ─── MinIO ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-docs
MINIO_USE_SSL=false

# ─── LLM / vLLM ────────────────────────────────────────────────────
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen2.5:32b

# ─── Embedding Service ─────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://embedding-worker:8100
EMBEDDING_MODEL_NAME=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ─── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=changeme-use-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Application ───────────────────────────────────────────────────
BACKEND_PORT=8000
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
